{
  "name": "pinyin-character",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 4444",
    "build": "next build",
    "start": "next start -p 4444",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "dict:build": "tsx scripts/build-dict.ts",
    "poetry:build": "tsx scripts/build-poems.ts",
    "build:classics": "tsx scripts/build-classics.ts",
    "radicals:build": "tsx scripts/build-radicals.ts",
    "radicals:import": "tsx --env-file=.env scripts/import-radicals.ts",
    "sutras:build": "tsx scripts/build-sutras.ts",
    "sutras:enrich-pinyin": "tsx scripts/enrich-sutra-pinyin.ts",
    "strokes:build": "tsx scripts/build-strokes.ts",
    "fonts:download": "tsx scripts/download-ancient-fonts.ts",
    "fonts:download-hard-pen": "tsx scripts/fonts/download-hard-pen-fonts.ts",
    "fonts:subset": "node scripts/fonts/subset-hard-pen-fonts.mjs",
    "fonts:hard-pen": "npm run fonts:download-hard-pen && npm run fonts:subset",
    "fonts:subset-ancient": "node scripts/fonts/subset-ancient-fonts.mjs",
    "fonts:verify-ancient": "node scripts/fonts/verify-ancient-subsets.mjs",
    "fonts:ancient": "npm run fonts:download && npm run fonts:subset-ancient && npm run fonts:verify-ancient",
    "fonts:subset-brush": "tsx scripts/fonts/subset-brush-fonts.mjs",
    "fonts:verify-brush": "tsx scripts/fonts/verify-brush-subsets.mjs",
    "fonts:brush": "npm run fonts:subset-brush && npm run fonts:verify-brush",
    "chars:import": "tsx scripts/import-chars-data.ts",
    "favicon:build": "tsx scripts/build-favicon.ts",
    "logo:build": "tsx scripts/build-logo-assets.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui"
  },
  "dependencies": {
    "@react-pdf/renderer": "^4.5.1",
    "bcryptjs": "^3.0.3",
    "edge-tts-universal": "^1.4.0",
    "hanzi-writer": "^3.7.0",
    "jsonwebtoken": "^9.0.3",
    "lucide-react": "^1.21.0",
    "mysql2": "^3.22.5",
    "next": "^15.1.6",
    "nodemailer": "^8.0.10",
    "opencc-js": "^1.0.5",
    "pinyin-pro": "^3.25.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "recharts": "^2.15.4",
    "server-only": "^0.0.1",
    "ws": "^8.21.0",
    "zod": "^4.4.3",
    "zustand": "^5.0.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.0.0-beta.3",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.4.0",
    "@testing-library/react": "^16.0.0",
    "@testing-library/user-event": "^14.5.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.9.0",
    "@types/nodemailer": "^8.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/ws": "^8.18.1",
    "@typescript-eslint/eslint-plugin": "^8.66.0",
    "@typescript-eslint/parser": "^8.66.0",
    "@vitest/ui": "^2.1.0",
    "cnchar": "^3.2.6",
    "cnchar-radical": "^3.2.6",
    "eslint": "^9.39.5",
    "eslint-config-next": "^15.5.22",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "fontkit": "^2.0.4",
    "happy-dom": "^15.0.0",
    "p-limit": "^6.0.0",
    "postcss": "^8.4.49",
    "prettier": "^3.9.6",
    "sharp": "0.33.5",
    "subset-font": "^2.4.0",
    "tailwindcss": "^4.0.0-beta.3",
    "to-ico": "^1.1.5",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^2.1.0"
  }
}
