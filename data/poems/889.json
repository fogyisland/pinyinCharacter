{
  "id": 889,
  "title": "天仙子",
  "author": "张先",
  "dynasty": "song",
  "category": null,
  "form": "杂言古风",
  "content": [
    "水调数声持酒听。",
    "午醉醒来愁未醒。",
    "送春春去几时回，临晚镜。",
    "伤流景。",
    "往事后期空记省。",
    "沙上并禽池上暝。",
    "云破月来花弄影。",
    "重重帘幕密遮灯，风不定。",
    "人初静。",
    "明日落红应满径。"
  ],
