{
  "id": 81,
  "title": "早秋三首 一",
  "author": "许浑",
  "dynasty": "tang",
  "category": "诗",
  "form": "五律",
  "content": [
    "遥夜泛清瑟，西风生翠萝。",
    "残萤委玉露，早鴈拂银河。",
    "高树晓还密，远山晴更多。",
    "淮南一叶下，自觉老烟波。"
  ],
