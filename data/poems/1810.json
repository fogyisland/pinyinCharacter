{
  "id": 1810,
  "title": "雄县观鱼",
  "author": "纳兰性德",
  "dynasty": "清",
  "category": "qing",
  "form": "10言古风",
  "content": [
    "渔师临广泽，侍从俯清澜",
    "瑞入王舟好，仁知圣网宽",
    "拨鳞飞白雪，行鲙缕金盘",
    "在藻同周宴，时容万姓看"
  ],
