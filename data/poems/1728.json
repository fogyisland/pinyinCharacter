{
  "id": 1728,
  "title": "南歌子·古戍",
  "author": "纳兰性德",
  "dynasty": "清",
  "category": "qing",
  "form": "杂言古风",
  "content": [
    "古戍饥乌集，荒城野雉飞",
    "何年劫火剩残灰，试看英雄碧血，满龙堆",
    "玉帐空分垒，金笳已罢吹",
    "东风回首尽成非，不道兴亡命也，岂人为"
  ],
