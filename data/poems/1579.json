{
  "id": 1579,
  "title": "生查子·东风不解愁",
  "author": "纳兰性德",
  "dynasty": "清",
  "category": "qing",
  "form": "10言古风",
  "content": [
    "东风不解愁，偷展湘裙衩",
    "独夜背纱笼，影著纤腰画",
    "爇尽水沉烟，露滴鸳鸯瓦",
    "花骨冷宜香，小立樱桃下"
  ],
