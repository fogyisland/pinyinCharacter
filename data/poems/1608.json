{
  "id": 1608,
  "title": "眼儿媚·重见星娥碧海槎",
  "author": "纳兰性德",
  "dynasty": "清",
  "category": "qing",
  "form": "12言古风",
  "content": [
    "重见星娥碧海槎，忍笑却盘鸦",
    "寻常多少，月明风细，今夜偏佳",
    "休笼彩笔闲书字，街鼓巳三挝",
    "烟丝欲袅，露光微泫，春在桃花"
  ],
