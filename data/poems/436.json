{
  "id": 436,
  "title": "阮郎归",
  "author": "秦观",
  "dynasty": "song",
  "category": null,
  "form": "杂言古风",
  "content": [
    "湘天风雨破寒初。",
    "深沈庭院虚。",
    "丽谯吹罢《小单于》。",
    "迢迢清夜徂。",
    "乡梦断，旅魂孤。",
    "峥嵘岁又除。",
    "衡阳犹有雁传书。",
    "郴阳和雁无。"
  ],
