{
  "id": 1621,
  "title": "浣溪沙·寄严荪友",
  "author": "纳兰性德",
  "dynasty": "清",
  "category": "qing",
  "form": "杂言古风",
  "content": [
    "藕荡桥边理钓筒，苎萝西去五湖东",
    "笔床茶灶太从容",
    "况有短墙银杏雨，更兼高阁玉兰风",
    "画眉闲了画芙蓉"
  ],
