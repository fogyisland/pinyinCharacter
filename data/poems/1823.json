  "title": "密云",
  "author": "纳兰性德",
  "dynasty": "清",
  "category": "qing",
  "form": "14言古风",
  "content": [
    "白檀山下水声秋，地踞潮河最上流",
    "日暮行人寻堠馆，凉砧一片古檀州"
  ],
