{
  "id": 961,
  "title": "瑞鹤仙",
  "author": "周邦彦",
  "dynasty": "song",
  "category": null,
  "form": "杂言古风",
  "content": [
    "悄郊原带郭。",
    "行路永，客去车尘漠漠。",
    "斜阳映山落。",
    "敛馀红、犹恋孤城栏角。",
    "凌波步弱。",
    "过短亭、何用素约。",
    "有流莺劝我，重解绣鞍，缓引春酌。",
    "不记归时早暮，上马谁扶，醒眠朱阁。",
    "惊飙动幕。",
    "扶残醉，绕红药。",
    "叹西园、已是花深无地，东风何事又恶。",
    "任流光过却。",
    "犹喜洞天自乐。"
  ],
