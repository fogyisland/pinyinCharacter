{
  "id": 853,
  "title": "唐多令",
  "author": "刘过",
  "dynasty": "song",
  "category": null,
  "form": "杂言古风",
  "content": [
    "芦叶满汀洲。",
    "塞沙带浅流。",
    "二十年、重过南楼。",
    "柳下系舟犹未稳，能几日、又中秋。",
    "黄鹤断矶头。",
    "故人今不在。",
    "旧江山，浑是新愁。",
    "欲买桂花同载酒，终不似、少年游。"
  ],
