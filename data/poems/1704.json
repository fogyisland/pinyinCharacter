{
  "id": 1704,
  "title": "浣溪沙·欲寄愁心朔雁边",
  "author": "纳兰性德",
  "dynasty": "清",
  "category": "qing",
  "form": "杂言古风",
  "content": [
    "欲寄愁心朔雁边，西风浊酒惨离颜",
    "黄花时节碧云天",
    "古戍烽烟迷斥堠，夕阳村落解鞍鞯",
    "不知征战几人还"
  ],
