{
  "id": 122,
  "title": "宿建德江",
  "author": "孟浩然",
  "dynasty": "tang",
  "category": null,
  "form": "10言古风",
  "content": [
    "移舟泊烟渚，日暮客愁新。",
    "野旷天低树，江清月近人。"
  ],
