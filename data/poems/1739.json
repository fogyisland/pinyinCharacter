{
  "id": 1739,
  "title": "天仙子·天咫尺",
  "author": "纳兰性德",
  "dynasty": "清",
  "category": "qing",
  "form": "杂言古风",
  "content": [
    "好在软绡红泪积，漏痕斜罥菱丝碧",
    "古钗封寄玉关秋，天咫尺，人南北，",
    "不信鸳鸯头不白"
  ],
