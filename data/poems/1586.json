{
  "id": 1586,
  "title": "江城子·咏史",
  "author": "纳兰性德",
  "dynasty": "清",
  "category": "qing",
  "form": "杂言古风",
  "content": [
    "湿云全压数峰低",
    "影凄迷，望中疑",
    "非雾非烟，神女欲来时、若问生涯原是梦，除梦里，没人知"
  ],
