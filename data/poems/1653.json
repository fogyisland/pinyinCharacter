{
  "id": 1653,
  "title": "相见欢·微云一抹遥峰",
  "author": "纳兰性德",
  "dynasty": "清",
  "category": "qing",
  "form": "9言古风",
  "content": [
    "微云一抹遥峰，冷溶溶",
    "恰与个人清晓，画眉同",
    "红蜡泪，青绫被，水沉浓",
    "却与黄茅野店，听西风"
  ],
