{
  "id": 614,
  "title": "惜分飞",
  "author": "毛滂",
  "dynasty": "song",
  "category": null,
  "form": "杂言古风",
  "content": [
    "泪湿阑干花著露。",
    "愁到眉峰碧聚。",
    "此恨平分取。",
    "更无言语。",
    "空相觑。",
    "短雨残云无意绪。",
    "寂寞朝朝暮暮。",
    "今夜山深处。",
    "断魂分付。",
    "潮回去。"
  ],
