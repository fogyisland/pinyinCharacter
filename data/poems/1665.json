{
  "id": 1665,
  "title": "眼儿媚·咏红姑娘",
  "author": "纳兰性德",
  "dynasty": "清",
  "category": "qing",
  "form": "12言古风",
  "content": [
    "骚屑西风弄晚寒，翠袖倚阑干",
    "霞绡裹处，樱唇微绽，靺鞨红殷",
    "故宫事往凭谁问，无恙是朱颜",
    "玉墀争采，玉钗争插，至正年间"
  ],
