{
  "id": 416,
  "title": "虞美人",
  "author": "舒亶",
  "dynasty": "song",
  "category": null,
  "form": "杂言古风",
  "content": [
    "芙蓉落尽天涵水。",
    "日暮沧波起。",
    "背飞双燕帖云寒。",
    "独向小楼东畔、倚阑看。",
    "浮生只合尊前老。",
    "雪满长安道。",
    "故人早晚上高台。",
    "赠我江南春色、一枝梅。"
  ],
