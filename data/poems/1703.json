{
  "id": 1703,
  "title": "赤枣子·风淅淅",
  "author": "纳兰性德",
  "dynasty": "清",
  "category": "qing",
  "form": "杂言古风",
  "content": [
    "风淅淅，雨纤纤",
    "难怪春愁细细添",
    "记不分明疑是梦，梦来还隔一重帘",
    " "
  ],
