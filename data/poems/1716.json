{
  "id": 1716,
  "title": "浣溪沙·十八年来堕世间",
  "author": "纳兰性德",
  "dynasty": "清",
  "category": "qing",
  "form": "杂言古风",
  "content": [
    "十八年来堕世间，吹花嚼蕊弄冰弦",
    "多情情寄阿谁边",
    "紫玉钗斜灯影背，红绵粉冷枕函偏",
    "相看好处却无言"
  ],
