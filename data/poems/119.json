{
  "id": 119,
  "title": "岁暮归南山",
  "author": "孟浩然",
  "dynasty": "tang",
  "category": null,
  "form": "10言古风",
  "content": [
    "北阙休上书，南山归敝庐。",
    "不才明主弃，多病故人疎。",
    "白发催年老，青阳逼岁除。",
    "永怀愁不寐，松月夜窗虚。"
  ],
