{
  "id": 1412,
  "title": "浪淘沙·望海",
  "author": "纳兰性德",
  "dynasty": "清",
  "category": "qing",
  "form": "杂言古风",
  "content": [
    "蜃阙半模糊，踏浪惊呼",
    "任将蠡测笑江湖",
    "沐日光华还浴月，我欲乘桴",
    "钓得六鳌无",
    "竿拂珊瑚",
    "桑田清浅问麻姑",
    "水气浮天天接水，那是蓬壶"
  ],
