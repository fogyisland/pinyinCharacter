{
  "id": 1594,
  "title": "赤枣子·惊晓漏",
  "author": "纳兰性德",
  "dynasty": "清",
  "category": "qing",
  "form": "杂言古风",
  "content": [
    "惊晓漏，护春眠",
    "格外娇慵只自怜",
    "寄语酿花风日好，绿窗来与上琴弦"
  ],
