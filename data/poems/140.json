{
  "id": 140,
  "title": "和贾舍人早朝大明宫之作",
  "author": "王维",
  "dynasty": "tang",
  "category": null,
  "form": "七律",
  "content": [
    "绛帻鸡人送晓筹，尚衣方进翠云裘。",
    "九天阊阖开宫殿，万国衣冠拜冕旒。",
    "日色才临仙掌动，香烟欲傍衮龙浮。",
    "朝罢须裁五色诏，佩声归向凤池头。"
  ],
