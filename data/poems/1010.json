{
  "id": 1010,
  "title": "眼儿媚",
  "author": "范成大",
  "dynasty": "song",
  "category": null,
  "form": "杂言古风",
  "content": [
    "酣酣日脚紫烟浮。",
    "妍暖破轻裘。",
    "困人天色，醉人花气，午梦扶头。",
    "春慵恰似春塘水，一片縠纹愁。",
    "溶溶泄泄，东风无力，欲皱还休。"
  ],
