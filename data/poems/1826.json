{
  "id": 1826,
  "title": "明月棹孤舟·海淀",
  "author": "纳兰性德",
  "dynasty": "清",
  "category": "qing",
  "form": "杂言古风",
  "content": [
    "一片亭亭空凝伫",
    "趁西风霓裳偏舞",
    "白鸟惊飞，菰蒲叶乱，断续浣纱人语",
    "丹碧驳残秋夜雨",
    "风吹去采菱越女",
    "辘轳声断，昏鸦欲起，多少博山情绪"
  ],
