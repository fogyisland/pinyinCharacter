{
  "id": 1637,
  "title": "清平乐·将愁不去",
  "author": "纳兰性德",
  "dynasty": "清",
  "category": "qing",
  "form": "杂言古风",
  "content": [
    "将愁不去，秋色行难住",
    "六曲屏山深院宇",
    "日日风风雨雨",
    "雨晴篱菊初香，人言此日重阳",
    "回首凉云暮叶，黄昏无限思量"
  ],
