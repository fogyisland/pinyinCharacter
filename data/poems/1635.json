{
  "id": 1635,
  "title": "好事近·马首望青山",
  "author": "纳兰性德",
  "dynasty": "清",
  "category": "qing",
  "form": "杂言古风",
  "content": [
    "马首望青山，零落繁华如此",
    "再向断烟衰草，认藓碑题字",
    "休寻折载话当年，只洒悲秋泪",
    "斜日十三陵下，过新丰猎骑"
  ],
