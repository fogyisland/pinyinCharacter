{
  "id": 157,
  "title": "终南望余雪",
  "author": "祖咏",
  "dynasty": "tang",
  "category": null,
  "form": "10言古风",
  "content": [
    "终南阴岭秀，积雪浮云端。",
    "林表明霁色，城中增暮寒。"
  ],
