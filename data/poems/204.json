{
  "id": 204,
  "title": "江雪",
  "author": "柳宗元",
  "dynasty": "tang",
  "category": null,
  "form": "10言古风",
  "content": [
    "千山鸟飞绝，万迳人踪灭。",
    "孤舟蓑笠翁，独钓寒江雪。"
  ],
