{
  "id": 1631,
  "title": "浣溪沙·旋拂轻容写洛神",
  "author": "纳兰性德",
  "dynasty": "清",
  "category": "qing",
  "form": "杂言古风",
  "content": [
    "旋拂轻容写洛神，须知浅笑是深颦",
    "十分天与可怜春",
    "掩抑薄寒施软障，抱持纤影藉芳茵",
    "未能无意下香尘"
  ],
