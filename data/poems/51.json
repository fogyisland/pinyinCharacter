{
  "id": 51,
  "title": "古意呈补阙乔知之",
  "author": "沈佺期",
  "dynasty": "tang",
  "category": null,
  "form": "14言古风",
  "content": [
    "卢家少妇郁金堂，海燕双栖玳瑁梁。",
    "九月寒砧催木叶，十年征戍忆辽阳。",
    "白狼河北音书断，丹凤城南秋夜长。",
    "谁谓含愁独不见，更教明月照流黄。"
  ],
