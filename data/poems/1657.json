{
  "id": 1657,
  "title": "卜算子·五日",
  "author": "纳兰性德",
  "dynasty": "清",
  "category": "qing",
  "form": "杂言古风",
  "content": [
    "村静午鸡啼，绿暗新阴覆",
    "一展轻帘出画墙，道是端阳酒",
    "早晚夕阳蝉，又噪长堤柳",
    "青鬓长青自古谁，弹指黄花九②"
  ],
