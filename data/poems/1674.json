{
  "id": 1674,
  "title": "临江仙·孤雁",
  "author": "纳兰性德",
  "dynasty": "清",
  "category": "qing",
  "form": "杂言古风",
  "content": [
    "霜冷离鸿惊失伴，有人同病相怜",
    "拟凭尺素寄愁边，愁多书屡易，双泪落灯前",
    "莫对月明思往事，也知消减年年",
    "无端嘹唳一声传，西风吹只影，刚是早秋天",
    " "
  ],
