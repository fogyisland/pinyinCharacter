{
  "id": 1736,
  "title": "清平乐·角声哀咽",
  "author": "纳兰性德",
  "dynasty": "清",
  "category": "qing",
  "form": "杂言古风",
  "content": [
    "角声哀咽，襆被驮残月",
    "过去华年如电掣，禁得番番离别",
    "一鞭冲破黄埃乱山影里徘徊",
    "蓦忆去年今日，十三陵下归来"
  ],
