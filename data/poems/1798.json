{
  "id": 1798,
  "title": "中元前一夕枕上偶成",
  "author": "纳兰性德",
  "dynasty": "清",
  "category": "qing",
  "form": "杂言古风",
  "content": [
    "酒醒池塘耿不眠，帐纹漠漠隔轻烟",
    "溪风到竹初疑雨，秋月如弓渐满弦",
    "残梦远经吹角戍，明河长亘衣天",
    "哀蛩饯晓浑多事，也似严更古驿边"
  ],
