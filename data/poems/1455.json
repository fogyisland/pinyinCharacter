{
  "id": 1455,
  "title": "清平乐·添烟深漾",
  "author": "纳兰性德",
  "dynasty": "清",
  "category": "qing",
  "form": "杂言古风",
  "content": [
    "麝烟深漾",
    "人拥缑笙氅",
    "新恨暗随新月长",
    "不辨眉尖心上",
    "六花斜扑疏帘",
    "地衣红锦轻沾",
    "记取暖香如梦，耐他一晌寒岩"
  ],
