{
  "id": 1757,
  "title": "菩萨蛮·惜春春去惊新燠",
  "author": "纳兰性德",
  "dynasty": "清",
  "category": "qing",
  "form": "杂言古风",
  "content": [
    "惜春春去惊新燠，粉融轻汗红绵扑",
    "妆罢只思眠，江南四月天",
    "绿阴帘半揭，此景清幽绝",
    "行度竹林风，单衫杏子红"
  ],
