{
  "id": 148,
  "title": "九月九日忆山东兄弟",
  "author": "王维",
  "dynasty": "tang",
  "category": null,
  "form": "14言古风",
  "content": [
    "独在异乡为异客，每逢佳节倍思亲。",
    "遥知兄弟登高处，遍插茱萸少一人。"
  ],
