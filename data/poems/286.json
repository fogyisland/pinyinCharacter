{
  "id": 286,
  "title": "秋夜寄丘二十二员外",
  "author": "韦应物",
  "dynasty": "tang",
  "category": null,
  "form": "10言古风",
  "content": [
    "怀君属秋夜，散步咏凉天。",
    "山空松子落，幽人应未眠。"
  ],
