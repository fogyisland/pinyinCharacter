{
  "id": 1613,
  "title": "生查子·鞭影落春堤",
  "author": "纳兰性德",
  "dynasty": "清",
  "category": "qing",
  "form": "10言古风",
  "content": [
    "鞭影落春堤，绿锦鄣泥卷",
    "脉脉逗菱丝，嫩水吴姬眼",
    "啮膝带香归，谁整樱桃宴",
    "蜡泪恼东风，旧垒眠新燕"
  ],
