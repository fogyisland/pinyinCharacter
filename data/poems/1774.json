{
  "id": 1774,
  "title": "虞美人·秋夕信步",
  "author": "纳兰性德",
  "dynasty": "清",
  "category": "qing",
  "form": "杂言古风",
  "content": [
    "愁痕满地无人省，露湿琅玕影",
    "闲阶小立倍荒凉",
    "还剩旧时月色在潇湘",
    "薄情转是多情累，曲曲柔肠碎",
    "红笺向壁字模糊，忆共灯前呵手为伊书"
  ],
