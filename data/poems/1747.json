{
  "id": 1747,
  "title": "菩萨蛮·阑风伏雨催寒食",
  "author": "纳兰性德",
  "dynasty": "清",
  "category": "qing",
  "form": "杂言古风",
  "content": [
    "阑风伏雨催寒食，樱桃一夜花狼藉",
    "刚与病相宜，锁窗薰绣衣",
    "画眉烦女伴，央及流莺唤",
    "半晌试开奁，娇多直自嫌"
  ],
