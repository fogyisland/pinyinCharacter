{
  "id": 1585,
  "title": "浣溪沙·庚申除夜",
  "author": "纳兰性德",
  "dynasty": "清",
  "category": "qing",
  "form": "杂言古风",
  "content": [
    "收取闲心冷处浓，舞裙犹忆柘枝红",
    "谁家刻烛待春风",
    "竹叶樽空翻采燕，九枝灯灺颤金虫",
    "风流端合倚天公"
  ],
