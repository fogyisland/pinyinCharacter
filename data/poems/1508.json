{
  "id": 1508,
  "title": "玉连环影",
  "author": "纳兰性德",
  "dynasty": "清",
  "category": "qing",
  "form": "杂言古风",
  "content": [
    "何处几叶萧萧雨",
    "湿尽檐花，花底人无语",
    "掩屏山，玉炉寒",
    "谁见两眉愁聚倚阑干"
  ],
