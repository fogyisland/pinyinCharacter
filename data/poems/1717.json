{
  "id": 1717,
  "title": "浣溪沙·已惯天涯莫浪愁",
  "author": "纳兰性德",
  "dynasty": "清",
  "category": "qing",
  "form": "杂言古风",
  "content": [
    "已惯天涯莫浪愁，寒云衰草渐成秋",
    "漫因睡起又登楼",
    "伴我萧萧惟代马，笑人寂寂有牵牛，劳人只合一生休"
  ],
