{
  "id": 473,
  "title": "蝶恋花",
  "author": "贺铸",
  "dynasty": "song",
  "category": null,
  "form": "杂言古风",
  "content": [
    "几许伤春春复暮。",
    "杨柳清阴，偏碍游丝度。",
    "天际小山桃叶步。",
    "白苹花满湔裙处。",
    "竟日微吟长短句。",
    "帘影灯昏，心寄胡琴语。",
    "数点雨声风约住。",
    "朦胧淡月云来去。"
  ],
