{
  "id": 1762,
  "title": "菩萨蛮·山城夜半催金柝",
  "author": "纳兰性德",
  "dynasty": "清",
  "category": "qing",
  "form": "杂言古风",
  "content": [
    "山城夜半催金柝，酒醒孤馆灯花落",
    "窗白一声鸡，枕函闻马嘶",
    "门前乌桕树，霜月迷行处",
    "遥忆独眠人，早寒惊梦频"
  ],
