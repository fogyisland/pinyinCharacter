{
  "id": 16,
  "title": "寄令狐郎中",
  "author": "李商隐",
  "dynasty": "tang",
  "category": null,
  "form": "14言古风",
  "content": [
    "嵩云秦树久离居，双鲤迢迢一纸书。",
    "休问梁园旧宾客，茂陵秋雨病相如。"
  ],
