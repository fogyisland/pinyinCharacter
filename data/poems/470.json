{
  "id": 470,
  "title": "天门谣",
  "author": "贺铸",
  "dynasty": "song",
  "category": null,
  "form": "杂言古风",
  "content": [
    "牛渚天门险。",
    "限南北、七雄豪占。",
    "清雾敛。",
    "与闲人登览。",
    "待月上潮平波滟滟。",
    "塞管轻吹新《阿滥》。",
    "风满槛。",
    "历历数、西州更点。"
  ],
