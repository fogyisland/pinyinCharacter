{
  "id": 1706,
  "title": "浣溪沙·雨歇梧桐泪乍收",
  "author": "纳兰性德",
  "dynasty": "清",
  "category": "qing",
  "form": "杂言古风",
  "content": [
    "雨歇梧桐泪乍收，遣怀翻自忆从头",
    "摘花销恨旧风流",
    "帘影碧桃人已去，屧痕苍藓径空留",
    "两眉何处月如钩"
  ],
