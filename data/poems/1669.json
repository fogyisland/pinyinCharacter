{
  "id": 1669,
  "title": "浣溪沙·古北口",
  "author": "纳兰性德",
  "dynasty": "清",
  "category": "qing",
  "form": "杂言古风",
  "content": [
    "杨柳千条送马蹄，北来征雁旧南飞",
    "客中谁与换春衣",
    "终古闲情归落照，一春幽梦逐游丝",
    "信回刚道别多时",
    " "
  ],
