{
  "id": 1758,
  "title": "菩萨蛮·寄梁汾苕中",
  "author": "纳兰性德",
  "dynasty": "清",
  "category": "qing",
  "form": "杂言古风",
  "content": [
    "知君此际情萧索，黄芦苦竹孤舟泊",
    "烟白酒旗青，水村鱼市晴",
    "柁楼今夕梦，脉脉春寒送",
    "直过画眉桥，钱塘江上潮"
  ],
