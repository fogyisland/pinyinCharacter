{
  "id": 1785,
  "title": "河传·春浅",
  "author": "纳兰性德",
  "dynasty": "清",
  "category": "qing",
  "form": "杂言古风",
  "content": [
    "春浅，红怨，掩双环",
    "微雨花间，昼闲",
    "无言暗将红泪弹",
    "阑珊，香销轻梦还",
    "斜倚画屏思往事，皆不是，空作相思字",
    "记当时垂柳丝，花枝，满庭蝴蝶儿"
  ],
