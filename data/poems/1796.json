{
  "id": 1796,
  "title": "扈跸霸州",
  "author": "纳兰性德",
  "dynasty": "清",
  "category": "qing",
  "form": "14言古风",
  "content": [
    "霸山重镇奠神京，鸾辂春游淑景明",
    "万呱银涛冲古岸，四围玉甃护严城",
    "花乘暖日迎来骑，柳带新膏绾去旌",
    "八寨雄图今更固，行随赏乐胜蓬瀛"
  ],
