{
  "id": 1740,
  "title": "天仙子·渌水亭秋夜",
  "author": "纳兰性德",
  "dynasty": "清",
  "category": "qing",
  "form": "杂言古风",
  "content": [
    "水浴凉蟾风入袂，鱼鳞蹙损金波碎",
    "好天良夜酒盈尊，心自醉，愁难睡",
    "西风月落城乌起"
  ],
