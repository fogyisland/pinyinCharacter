{
  "id": 223,
  "title": "阁夜",
  "author": "杜甫",
  "dynasty": "tang",
  "category": null,
  "form": "14言古风",
  "content": [
    "岁暮阴阳催短景，天涯霜雪霁寒宵。",
    "五更鼓角声悲壮，三峡星河影动摇。",
    "野哭几家闻战伐，夷歌数处起渔樵。",
    "卧龙跃马终黄土，人事依依漫寂寥。"
  ],
