{
  "id": 990,
  "title": "瑞鹤仙",
  "author": "蒋捷",
  "dynasty": "song",
  "category": null,
  "form": "杂言古风",
  "content": [
    "绀烟迷雁迹。",
    "渐断鼓零钟，街喧初息。",
    "风檠背寒壁。",
    "放冰蜍飞到，丝丝窗隙。",
    "琼瑰暗泣。",
    "念乡关、霜芜似织。",
    "漫将身、化鹤归来，忘却旧游端的。",
    "欢极。",
    "蓬壶蕖浸，花院梨溶，醉连春夕。",
    "柯云罢弈。",
    "樱桃在，梦难觅。",
    "劝清光，乍可幽窗相伴，休照红楼夜笛。",
    "怕人间、换谱伊凉，素娥未识。"
  ],
