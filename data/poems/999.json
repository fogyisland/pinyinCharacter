{
  "id": 999,
  "title": "点绛唇",
  "author": "汪藻",
  "dynasty": "song",
  "category": null,
  "form": "杂言古风",
  "content": [
    "新月娟娟，夜寒江静山衔斗。",
    "起来搔首。",
    "梅影横窗瘦。",
    "好个霜天，闲却传杯手。",
    "君知否。",
    "乱鸦啼后。",
    "归兴浓于酒。"
  ],
