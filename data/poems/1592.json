{
  "id": 1592,
  "title": "浣溪沙·脂粉塘空遍绿苔",
  "author": "纳兰性德",
  "dynasty": "清",
  "category": "qing",
  "form": "杂言古风",
  "content": [
    "脂粉塘空遍绿苔",
    "掠泥营垒燕相催",
    "妒他飞去却飞回",
    "一骑近从梅里过，片帆遥自藕溪来",
    "博山香烬未全灰"
  ],
