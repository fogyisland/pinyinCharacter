{
  "id": 399,
  "title": "御街行",
  "author": "晏几道",
  "dynasty": "song",
  "category": null,
  "form": "杂言古风",
  "content": [
    "街南绿树春饶絮。",
    "雪满游春路。",
    "树头花艳杂娇云，树底人家朱户。",
    "北楼闲上，疏帘高卷，直见街南树。",
    "阑干倚尽犹慵去。",
    "几度黄昏雨。",
    "晚春盘马踏青苔，曾傍绿阴深驻。",
    "落花犹在，香屏空掩，人面知何处。"
  ],
