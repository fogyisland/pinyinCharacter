{
  "id": 1615,
  "title": "浣溪沙·姜女庙",
  "author": "纳兰性德",
  "dynasty": "清",
  "category": "qing",
  "form": "杂言古风",
  "content": [
    "海色残阳影断霓，寒涛日夜女郎祠",
    "翠钿尘网上蛛丝",
    "澄海楼高空极目，望夫石在且留题",
    "六王如梦祖龙非"
  ],
