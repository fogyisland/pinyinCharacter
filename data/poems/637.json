{
  "id": 637,
  "title": "菩萨蛮",
  "author": "陈克",
  "dynasty": "song",
  "category": null,
  "form": "杂言古风",
  "content": [
    "绿芜墙绕青苔院。",
    "中庭日淡芭蕉卷。",
    "蝴蝶上阶飞。",
    "烘帘自在垂。",
    "玉钩双语燕。",
    "宝甃杨花转。",
    "几处簸钱声。",
    "绿窗春睡轻。"
  ],
