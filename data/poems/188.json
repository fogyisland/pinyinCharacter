{
  "id": 188,
  "title": "渡汉江",
  "author": "李频",
  "dynasty": "tang",
  "category": null,
  "form": "10言古风",
  "content": [
    "岭外音书绝，经年复历春。",
    "近乡情更怯，不敢问来人。"
  ],
