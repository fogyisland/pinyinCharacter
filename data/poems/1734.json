{
  "id": 1734,
  "title": "清平乐·青陵蝶梦",
  "author": "纳兰性德",
  "dynasty": "清",
  "category": "qing",
  "form": "杂言古风",
  "content": [
    "青陵蝶梦，倒挂怜么凤",
    "退粉收香情一种，栖傍玉钗偷共",
    "愔愔镜阁飞蛾，谁传锦字秋河",
    "莲子依然隐雾，菱花暗惜横波"
  ],
