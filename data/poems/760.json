{
  "id": 760,
  "title": "菩萨蛮",
  "author": "晏几道",
  "dynasty": "song",
  "category": null,
  "form": "杂言古风",
  "content": [
    "哀筝一弄湘江曲。",
    "声声写尽湘波绿。",
    "纤指十三弦。",
    "细将幽恨传。",
    "当筵秋水慢。",
    "玉柱斜飞雁。",
    "弹到断肠时。",
    "春山眉黛低。"
  ],
