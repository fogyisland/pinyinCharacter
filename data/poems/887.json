{
  "id": 887,
  "title": "醉垂鞭",
  "author": "张先",
  "dynasty": "song",
  "category": null,
  "form": "杂言古风",
  "content": [
    "双蝶绣罗裙。",
    "东池宴。",
    "初相见。",
    "朱粉不深匀。",
    "闲花淡淡春。",
    "细看诸处好。",
    "人人道。",
    "柳腰身。",
    "昨日乱山昏。",
    "来时衣上云。"
  ],
