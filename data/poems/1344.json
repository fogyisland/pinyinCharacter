{
  "id": 1344,
  "title": "诉衷情·冷落绣衾谁与伴",
  "author": "纳兰性德",
  "dynasty": "清",
  "category": "qing",
  "form": "杂言古风",
  "content": [
    "冷落绣衾谁与伴，倚香篝",
    "春睡起，斜日照梳头",
    "欲写两眉愁，休休",
    "远山残翠收，莫登楼"
  ],
