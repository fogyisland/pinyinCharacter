{
  "id": 1326,
  "title": "忆秦娥·山重叠",
  "author": "纳兰性德",
  "dynasty": "清",
  "category": "qing",
  "form": "杂言古风",
  "content": [
    "山重叠",
    "悬崖一线天疑裂",
    "天疑裂",
    "断碑题字，苔痕横啮",
    "风声雷动鸣金铁",
    "阴森潭底蛟龙窟",
    "蛟龙窟",
    "兴亡满眼，旧时明月"
  ],
