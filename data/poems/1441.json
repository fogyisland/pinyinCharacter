{
  "id": 1441,
  "title": "鬓云松令·枕函香",
  "author": "纳兰性德",
  "dynasty": "清",
  "category": "qing",
  "form": "杂言古风",
  "content": [
    "枕函香，花径漏",
    "依约相逢，絮语黄昏后",
    "时节薄寒人病酒，刬地梨花，彻夜东风瘦",
    "掩银屏，垂翠袖",
    "何处吹箫，脉脉情微逗",
    "肠断月明红豆蔻，月似当时，人似当时否"
  ],
