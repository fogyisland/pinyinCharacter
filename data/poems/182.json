{
  "id": 182,
  "title": "问刘十九",
  "author": "白居易",
  "dynasty": "tang",
  "category": null,
  "form": "10言古风",
  "content": [
    "绿螘新醅酒，红泥小火垆。",
    "晚来天欲雪，能饮一杯无。"
  ],
