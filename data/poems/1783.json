{
  "id": 1783,
  "title": "采桑子·巂周声里严关峙",
  "author": "纳兰性德",
  "dynasty": "清",
  "category": "qing",
  "form": "杂言古风",
  "content": [
    "巂周声里严关峙，匹马登登，乱踏黄尘",
    "听报邮签第几程",
    "行人莫话前朝事，风雨诸陵，寂寞鱼灯",
    "天寿山头冷月横"
  ],
