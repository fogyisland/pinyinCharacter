{
  "id": 1640,
  "title": "清平乐·才听夜雨",
  "author": "纳兰性德",
  "dynasty": "清",
  "category": "qing",
  "form": "杂言古风",
  "content": [
    "才听夜雨，便觉秋如许",
    "绕砌蛩螀人不语，有梦转愁无据",
    "乱山千叠横江，忆君游倦何方",
    "知否小窗红烛",
    "照人此夜凄凉"
  ],
