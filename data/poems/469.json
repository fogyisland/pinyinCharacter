{
  "id": 469,
  "title": "减字浣溪沙・浣溪沙",
  "author": "贺铸",
  "dynasty": "song",
  "category": null,
  "form": "杂言古风",
  "content": [
    "楼角初销一缕霞。",
    "淡黄杨柳暗栖鸦。",
    "玉人和月摘梅花。",
    "笑拈粉香归洞户，更垂帘幕护窗纱。",
    "东风寒似夜来些。"
  ],
