{
  "id": 1818,
  "title": "菩萨蛮·春花春月年年客",
  "author": "纳兰性德",
  "dynasty": "清",
  "category": "qing",
  "form": "杂言古风",
  "content": [
    "春花春月年年客，怜春又怕春离别",
    "只为晓风愁，催花扑玉钩",
    "娟娟双蛱蝶，宛转飞花侧",
    "花底一声歌，疼花花奈何"
  ],
