{
  "id": 1334,
  "title": "浣溪沙·万里阴山万里沙",
  "author": "纳兰性德",
  "dynasty": "清",
  "category": "qing",
  "form": "杂言古风",
  "content": [
    "万里阴山万里沙",
    "谁将绿鬓斗霜华",
    "年来强半在天涯",
    "魂梦不离金屈戌，画图亲展玉鸦叉",
    "生怜瘦减一分花"
  ],
