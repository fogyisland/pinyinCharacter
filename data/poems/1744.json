{
  "id": 1744,
  "title": "浣溪沙·身向云山那畔行",
  "author": "纳兰性德",
  "dynasty": "清",
  "category": "qing",
  "form": "杂言古风",
  "content": [
    "身向云山那畔行，北风吹断马嘶声",
    "深秋远塞若为情",
    "一抹晚烟荒戍垒，半竿斜日旧关城",
    "古今幽恨几时平"
  ],
