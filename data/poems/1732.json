{
  "id": 1732,
  "title": "一络索·过尽遥山如画",
  "author": "纳兰性德",
  "dynasty": "清",
  "category": "qing",
  "form": "杂言古风",
  "content": [
    "过尽遥山如画",
    " 短衣匹马",
    " 萧萧落木不胜秋， 莫回首、 斜阳下",
    "别是柔肠萦挂",
    " 待归才罢",
    " 却愁拥髻向灯前， 说不尽、 离人话"
  ],
