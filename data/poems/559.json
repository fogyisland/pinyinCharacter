{
  "id": 559,
  "title": "浣溪沙",
  "author": "吴文英",
  "dynasty": "song",
  "category": null,
  "form": "杂言古风",
  "content": [
    "波面铜花冷不收。",
    "玉人垂钓理纤钩。",
    "月明池阁夜来秋。",
    "江燕话归成晓别，水花红减似春休。",
    "西风梧井叶先愁。"
  ],
