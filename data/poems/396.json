{
  "id": 396,
  "title": "阮郎归",
  "author": "晏几道",
  "dynasty": "song",
  "category": null,
  "form": "杂言古风",
  "content": [
    "天边金掌露成霜。",
    "云随雁字长。",
    "绿杯红袖称重阳。",
    "人情似故乡。",
    "兰佩紫，菊簪黄。",
    "殷勤理旧狂。",
    "欲将沈醉换悲凉。",
    "清歌莫断肠。"
  ],
