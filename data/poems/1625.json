{
  "id": 1625,
  "title": "如梦令·木叶纷纷归路",
  "author": "纳兰性德",
  "dynasty": "清",
  "category": "qing",
  "form": "杂言古风",
  "content": [
    "木叶纷纷归路",
    "残月晓风何处",
    "消息半浮沈，今夜相思几许",
    "秋雨，秋雨",
    "一半西风吹去"
  ],
