{
  "id": 1680,
  "title": "渔父·收却纶竿落照红",
  "author": "纳兰性德",
  "dynasty": "清",
  "category": "qing",
  "form": "杂言古风",
  "content": [
    "收却纶竿落照红，秋风宁为翦芙蓉",
    "人淡淡，水濛濛，吹入芦花短笛中"
  ],
