{
  "id": 1725,
  "title": "南乡子·为亡妇题照",
  "author": "纳兰性德",
  "dynasty": "清",
  "category": "qing",
  "form": "杂言古风",
  "content": [
    "泪咽却无声",
    "只向从前悔薄情，凭仗丹青重省识",
    "盈盈",
    "一片伤心画不成",
    "别语忒分明",
    "午夜鹣鹣梦早醒",
    "卿自早醒侬自梦，更更",
    "泣尽风檐夜雨铃"
  ],
