{
  "id": 1428,
  "title": "浣溪沙·记绾长条欲别难",
  "author": "纳兰性德",
  "dynasty": "清",
  "category": "qing",
  "form": "杂言古风",
  "content": [
    "记绾长条欲别难",
    "盈盈自此隔银湾",
    "便无风雪也摧残",
    "青雀几时裁锦字，玉虫连夜翦春旙",
    "不禁辛苦况相关"
  ],
