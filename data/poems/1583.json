{
  "id": 1583,
  "title": "生查子·短焰剔残花",
  "author": "纳兰性德",
  "dynasty": "清",
  "category": "qing",
  "form": "10言古风",
  "content": [
    "短焰剔残花，夜久边声寂",
    "倦舞却闻鸡，暗觉青绫湿",
    "天水接冥蒙，一角西南白",
    "欲渡浣花溪，远梦轻无力"
  ],
