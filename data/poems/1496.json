{
  "id": 1496,
  "title": "遐方怨·欹角枕",
  "author": "纳兰性德",
  "dynasty": "清",
  "category": "qing",
  "form": "杂言古风",
  "content": [
    "欹角枕，掩红窗",
    "梦到江南，伊家博山沉水香",
    "湔裙归晚坐思量",
    "轻烟笼浅黛，月茫茫"
  ],
