{
  "id": 1824,
  "title": "芳树",
  "author": "纳兰性德",
  "dynasty": "清",
  "category": "qing",
  "form": "10言古风",
  "content": [
    "连理无分影，同心岂独芳",
    "傍檐巢翡翠，临水宿鸳鸯",
    "叶叶含春思，枝枝向画廊",
    "君情若比树，妾意复何伤",
    "陌上谁攀折，闺中思复侵",
    "眼凝清露重，眉敛翠烟深",
    "羌笛临风曲，悲笳出塞音",
    "纵垂千万缕，那系别离心"
  ],
