{
  "id": 127,
  "title": "和张仆射塞下曲 一",
  "author": "卢纶",
  "dynasty": "tang",
  "category": null,
  "form": "10言古风",
  "content": [
    "鹫翎金仆姑，燕尾绣蝥弧。",
    "独立扬新令，千营共一呼。"
  ],
