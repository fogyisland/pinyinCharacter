{
  "id": 1599,
  "title": "浣溪沙·睡起惺忪强自支",
  "author": "纳兰性德",
  "dynasty": "清",
  "category": "qing",
  "form": "杂言古风",
  "content": [
    "睡起惺忪强自支",
    "绿倾蝉鬓下帘时",
    "夜来愁损小腰肢",
    "远信不归空伫望，幽期细数却参差",
    "更兼何事耐寻思"
  ],
