{
  "id": 385,
  "title": "清平乐",
  "author": "王安国",
  "dynasty": "song",
  "category": null,
  "form": "杂言古风",
  "content": [
    "留春不住。",
    "费尽莺儿语。",
    "满地残红宫锦污。",
    "昨夜南园风雨。",
    "小怜初上琵琶。",
    "晓来思绕天涯。",
    "不肯画堂朱户，春风自在梨花。"
  ],
