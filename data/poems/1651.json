{
  "id": 1651,
  "title": "浣溪沙·咏五更，和湘真韵",
  "author": "纳兰性德",
  "dynasty": "清",
  "category": "qing",
  "form": "杂言古风",
  "content": [
    "微晕娇花湿欲流，簟纹灯影一生愁",
    "梦回疑在远山楼",
    "残月暗窥金屈戍，软风徐荡玉帘钩",
    "待听邻女唤梳头"
  ],
