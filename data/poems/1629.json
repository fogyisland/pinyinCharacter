{
  "id": 1629,
  "title": "浣溪沙·容易浓香近画屏",
  "author": "纳兰性德",
  "dynasty": "清",
  "category": "qing",
  "form": "杂言古风",
  "content": [
    "容易浓香近画屏，繁枝影著半窗横",
    "风波狭路倍怜卿",
    "未接语言犹怅望，才通商略已懵腾",
    "只嫌今夜月偏明"
  ],
