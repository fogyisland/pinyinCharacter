# dependencies
node_modules/
.pnp
.pnp.js

# build output
.next/
out/
# ⚠️ Root-anchored: a bare `build/` would also match ANY directory named
# `build` at any depth — including the API route directory
# `app/api/admin/webfonts/build/`, which must be tracked.
/build/
dist/
tsconfig.tsbuildinfo

# env
.env
.env.local
.env.*.local

# runtime data
data/runtime/
*.log
.DS_Store

# mysqldump / db backups (huge binary, regenerable)
backups/

# build artifacts (regenerate with pnpm strokes:build) — TRACKED in git as
# of 2026-07-09 so deploys don't have to wait for the 10-min CDN fetch.
# Local files stay in public/strokes/ unchanged; .gitignore line removed.
# public/strokes/
# data/strokes-manifest.json

# poems build artifacts (regenerate with pnpm tsx scripts/build-poems-extra.ts)
# These are collection files (slug-named), not individual poem files (id-named).
data/poems/yuefu.json
data/poems/shijiu.json
data/poems/cifu.json
data/poems/caocao.json
data/poems/nalan.json

# font staging (regenerate with pnpm fonts:download-hard-pen)
scripts/fonts/staging/

# editor
.vscode/
.idea/

# tool caches
.claude/
.superpowers/

# deploy bundle — regenerated with scripts/copy-to-up.py
Up/

# throwaway working files (font-comparison screenshots, scratch)
.tmp/

# precompressed asset sidecars (generated by scripts/precompress-assets.mjs)
*.br
*.gz

# ⚠️ The blanket `*.gz` above keeps the precompress-assets sidecars out of
# git. The classics corpus is the EXCEPTION: it is stored gzipped in the
# repository (251 MB of JSON would otherwise be the largest thing in the
# packed repo). The read path falls back to `.json.gz` — see
# lib/json-fs.ts's readJsonAuto.
# ⚠️ Without this rule `git add data/classics` silently skips every file
# and the commit looks successful while shipping nothing.
!data/classics/*.json.gz
