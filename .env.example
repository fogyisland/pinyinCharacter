# ====================================================================
# 字·韵 生产环境变量模板
# Copy to .env on the server and replace each placeholder.
# ====================================================================

# --- Database (Plan B 必需) ---
# ⚠️ 生产环境 DATABASE_URL 禁止指向 127.0.0.1 / localhost / piyin_dev
#    否则 lib/env.ts 的 validateEnv 会在 instrumentation.ts 启动时拒绝启动
DATABASE_URL=mysql://USER:PASSWORD@PROD_HOST:3306/pinyin_prod
DATABASE_URL_TEST=mysql://USER:PASSWORD@PROD_HOST:3306/pinyin_test

# --- JWT signing key (必需) ---
# 必须 ≥32 字节,且不能用仓库里这个示例值
# 生成: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
JWT_SECRET=replace-me-with-32-bytes-of-random-base64

# --- Cookie security (必需) ---
# 生产必须严格 true,否则 auth cookie 在 HTTP 明文传输会被劫持
COOKIE_SECURE=true

# --- NEXT_PUBLIC_SITE_URL (可选,但强烈建议设置) ---
# 影响 canonical URL 和 sitemap.xml 输出。优先级低于 admin UI 的 site.url 配置
# 建议: 在 /admin/settings/site-url 设置,而不是手动 .env
# NEXT_PUBLIC_SITE_URL=https://your-domain.com

# --- Email (可选,生产建议配 SMTP) ---
MAIL_TRANSPORT=console               # console | smtp
SMTP_HOST=                           # MAIL_TRANSPORT=smtp 时必填
SMTP_PORT=587
SMTP_SECURE=false                    # true for port 465
SMTP_USER=
SMTP_PASS=
MAIL_FROM=noreply@your-domain.com    # MAIL_TRANSPORT=smtp 时必填
MAIL_FROM_NAME=字·韵

# --- AI content generation (Plan D, scripts/generate-stories.ts 唯一使用) ---
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
# LLM_PROVIDER and LLM_MODEL are CLI args, not env vars

# --- Plan H — AI config 已迁移到 app_config 表 ---
# 在 /admin/ai (配置 tab) 编辑。无需新增 env 变量,DB 是 source of truth。
# ANTHROPIC_API_KEY / OPENAI_API_KEY (lib/llm.ts 用的那个) 仍然需要。

# ====================================================================
# 服务器首次部署步骤:
# 1. cp .env.example .env  →  替换所有 placeholder 为实际值
# 2. pnpm install
# 3. pnpm tsx scripts/init-db.ts      # 建表 + seed app_config + auto-populate poems/sutras/chars
# 4. pnpm build
# 5. pnpm start                       # 会跑在 :4444
# 6. 浏览器访问 http://localhost:4444/admin/init, 验证 12 步 checklist 全绿
# ====================================================================